---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import Hr from "@/components/Hr.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout title="Rahul Karkera">
  <Header />
  <main id="main-content" data-layout="index" class="relative pt-2 pb-6">
    <section id="hero" class="pt-4 pb-4">
      <h1 class="my-3 inline-block font-bold sm:my-4 top-accent pb-2 hero-name">
        Rahul Karkera
      </h1>
      <a
        target="_blank"
        href="/rss.xml"
        class="inline-block"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>
        I'm a Senior Software Engineer at Infratab, where I build production-grade backend systems 
        and cloud infrastructure. I specialize in designing scalable solutions using Python/Django, 
        containerization with Kubernetes, and cloud deployments on Azure. My work focuses on creating 
        robust APIs, optimizing distributed systems, and implementing CI/CD pipelines.
      </p>
      <p class="mt-2">
        On this blog, I share insights on backend architecture, cloud-native development, DevOps best practices, 
        and practical lessons from building scalable systems.
      </p>
      {
        // only display if at least one social link is enabled
        SOCIALS.length > 0 && (
          <div class="mt-3 flex flex-col sm:flex-row sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">Connect with me:</div>
            <Socials />
          </div>
        )
      }
    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured" class="pt-6 pb-4">
            <div class="flex items-center gap-3 mb-3">
              <h2 class="text-2xl font-semibold tracking-wide dot-indicator">Featured</h2>
            </div>
            <ul>
              {featuredPosts.map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          </section>
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-6 pb-4">
          <div class="flex items-center gap-3 mb-3">
            <h2 class="text-2xl font-semibold tracking-wide dot-indicator">Recent Posts</h2>
          </div>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-6 text-center">
      <LinkButton href="/posts/">
        All Posts
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
